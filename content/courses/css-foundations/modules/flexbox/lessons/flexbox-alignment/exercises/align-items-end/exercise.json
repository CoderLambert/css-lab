{
  "schemaVersion": 2,
  "id": "css.flexbox.alignment.align-items-end.001",
  "revision": 2,
  "slug": "align-items-end",
  "title": "沿交叉轴末端对齐",
  "prompt": "让三个项目沿 column 的 main axis 依次排列，并沿容器 cross axis 的末端对齐；在默认水平书写模式中，这会表现为水平方向靠右。",
  "order": 3,
  "status": "published",
  "hints": [
    "先确认 .container 使用 column；这道题不要求改变项目自身的尺寸。",
    "column 的 main axis 是纵向，cross axis 是水平方向，因此 cross-axis end 在常见书写模式中是右侧。",
    "用 align-items 控制整组项目的 cross axis。经典 Flexbox 写法是 flex-end；现代 Box Alignment 的 end 在本题中也视为正确。"
  ],
  "checks": [
    {
      "id": "container-display-flex",
      "type": "style",
      "selector": ".container",
      "property": "display",
      "equals": "flex",
      "message": "将 .container 设置为 flex 布局"
    },
    {
      "id": "container-flex-direction-column",
      "type": "style",
      "selector": ".container",
      "property": "flex-direction",
      "equals": "column",
      "message": "让 .container 使用 column main axis"
    },
    {
      "id": "container-align-flex-end",
      "type": "style",
      "selector": ".container",
      "property": "align-items",
      "equals": "flex-end",
      "alsoAccepts": [
        "end"
      ],
      "message": "让项目沿交叉轴末端对齐"
    }
  ],
  "workspace": {
