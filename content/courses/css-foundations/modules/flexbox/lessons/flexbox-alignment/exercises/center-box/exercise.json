  "id": "css.flexbox.alignment.center-box.001",
  "revision": 1,
  "slug": "center-box",
  "title": "水平与垂直居中",
  "prompt": "修改 CSS，让绿色方块同时在容器的水平与垂直方向居中。",
  "order": 1,
  "status": "published",
  "hints": [
    "先确认 .container 已经进入 flex 布局上下文；如果 display 仍是 block，后面的对齐属性不会按 Flexbox 工作。",
    "默认 flex-direction: row 时，主轴是水平方向，交叉轴是垂直方向。",
    "主轴居中看 justify-content，交叉轴居中看 align-items；这两个方向都需要设置为 center。"
  ],
  "checks": [
    {"id":"container-display-flex","type":"style","selector":".container","property":"display","equals":"flex","message":"将 .container 设置为 flex 布局"},
    {"id":"container-justify-content-center","type":"style","selector":".container","property":"justify-content","equals":"center","message":"将主轴上的内容居中"},
    {"id":"container-align-items-center","type":"style","selector":".container","property":"align-items","equals":"center","message":"将交叉轴上的内容居中"}
  ],
  "workspace": {"files":[
    {"path":"index.html","language":"html","editable":false},
    {"path":"base.css","language":"css","editable":false},
    {"path":"style.css","language":"css","editable":true}
  ]},
  "runtime": {"type":"browser","entry":"index.html"}
}
