  "id": "css.flexbox.alignment.center-box.001",
  "revision": 1,
  "slug": "center-box",
  "title": "水平与垂直居中",
  "prompt": "在默认 row 方向的 flex container 中，让绿色方块同时沿 main axis 与 cross axis 居中。",
  "order": 1,
  "status": "published",
  "hints": [
    "先读取题目的轴上下文；本题使用默认 row，目标是两个轴都居中。",
    "row 下 main axis 沿 inline direction，cross axis 与它垂直。",
    "main axis 居中看 justify-content，cross axis 居中看 align-items；这两个方向都需要设置为 center。"
  ],
  "checks": [
    {
      "id": "container-display-flex",
      "type": "style",
      "selector": ".container",
      "property": "display",
      "equals": "flex",
      "message": "将 .container 设置为 flex 布局"
    },
    {
      "id": "container-justify-content-center",
      "type": "style",
      "selector": ".container",
      "property": "justify-content",
      "equals": "center",
      "message": "将主轴上的内容居中"
    },
    {
      "id": "container-align-items-center",
      "type": "style",
      "selector": ".container",
      "property": "align-items",
      "equals": "center",
      "message": "将交叉轴上的内容居中"
    }
  ],
