      "type": "style",
      "selector": ".primary",
      "property": "flex-grow",
      "equals": "2",
      "message": "让 primary 使用 flex-grow: 2"
    },
    {
      "id": "secondary-grow",
      "type": "style",
      "selector": ".secondary",
      "property": "flex-grow",
      "equals": "1",
      "message": "让 secondary 使用 flex-grow: 1"
    }
  ]
