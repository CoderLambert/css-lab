{
  "schemaVersion": 2,
  "id": "css.box-model-and-flow.sizing-constraints-and-overflow.debug-fixed-width-failure.001",
  "revision": 2,
  "slug": "debug-fixed-width-failure",
  "title": "修复固定宽度失败",
  "prompt": "让同一条 .avatar 规则同时适应两个锁定 containing block：窄容器中不能溢出，宽容器中仍保留 320px 的 preferred width。不要按当前样例硬编码最终像素宽度、扩大容器或隐藏头像。",
  "order": 4,
  "status": "draft",
  "hints": [
    "先比较两个 frame：为什么同一个 320px preferred width 在窄容器里需要缩小、在宽容器里不需要？",
    "保留 .avatar 的 width: 320px 意图，再用可用空间作为上限；不要针对某个样例硬编码最终像素宽度。",
    "对 .avatar 设置 max-width: 100%。"
  ],
  "checks": [
    {
      "id": "preferred-width-kept",
      "type": "rule-style",
      "path": "style.css",
      "selector": ".avatar",
      "property": "width",
      "equals": "320px",
      "message": "在 style.css 中保留 .avatar 的 width: 320px preferred width 声明"
    },
    {
      "id": "containing-width-cap",
      "type": "rule-style",
      "path": "style.css",
      "selector": ".avatar",
      "property": "max-width",
      "equals": "100%",
      "message": "在 style.css 中为 .avatar 声明基于可用空间的 max-width: 100%"
    },
    {
      "id": "containing-width-cap-applied",
      "type": "style",
      "selector": ".frame:first-of-type .avatar",
      "property": "max-width",
      "equals": "100%",
      "message": "窄容器里的头像实际 max-width 上限应为 100%，不能被其他规则覆盖"
    },
    {
      "id": "fixture-width-kept",
      "type": "style",
      "selector": ".frame:first-of-type",
      "property": "width",
      "equals": "180px",
      "message": "保持第一个 frame 的 180px 窄容器约束"
    },
    {
      "id": "wide-fixture-width-kept",
      "type": "style",
      "selector": ".frame:last-of-type",
      "property": "width",
      "equals": "400px",
      "message": "保持第二个 frame 的 400px 宽容器对照约束"
    },
    {
      "id": "fixture-box-sizing-kept",
      "type": "style",
      "selector": ".frame:first-of-type",
      "property": "box-sizing",
      "equals": "border-box",
      "message": "保持窄 frame 的 border-box，让 180px 继续包含内边距和边框"
    },
    {
      "id": "wide-fixture-box-sizing-kept",
      "type": "style",
      "selector": ".frame:last-of-type",
      "property": "box-sizing",
      "equals": "border-box",
      "message": "保持宽 frame 的 border-box 对照环境"
    },
    {
      "id": "wide-preferred-width-applied",
      "type": "style",
      "selector": ".frame:last-of-type .avatar",
      "property": "width",
      "equals": "320px",
      "message": "空间足够时，头像的实际宽度应继续体现 320px preferred width"
    },
    {
      "id": "wide-avatar-box-sizing-kept",
      "type": "style",
      "selector": ".frame:last-of-type .avatar",
      "property": "box-sizing",
      "equals": "border-box",
      "message": "宽容器中的头像保持 border-box，320px 才代表实际 border-box 宽度"
    },
    {
      "id": "wide-avatar-fits-frame",
      "type": "layout-contained",
      "selector": ".frame:last-of-type .avatar",
      "within": ".frame:last-of-type",
      "axis": "x",
      "message": "宽容器中的头像也必须保持实际可见、静态且位于容器内容区"
    },
    {
      "id": "avatar-fits-frame",
      "type": "layout-contained",
      "selector": ".frame:first-of-type .avatar",
      "within": ".frame:first-of-type",
      "axis": "x",
      "message": "窄容器中的头像需要有实际显示尺寸，且左右边界不能超出容器内容区"
    }
  ],
