  "id": "css.cascade-and-values.inheritance-and-defaults.contrast-non-inherited.001",
  "revision": 1,
  "slug": "contrast-non-inherited",
  "title": "对比不会自动继承的属性",
  "prompt": "只修改 .panel：设置 font-weight: 700 和 border-style: solid。观察 .child 会继承 font-weight，但自己的 border-top-style 仍应是 none。",
  "order": 2,
  "status": "draft",
  "hints": [
    "font-weight 默认继承，而 border-style 默认不继承。",
    "两个 declarations 都写在 parent .panel 上；不要给 .child 补 border。",
    "设置 .panel 的 font-weight: 700 和 border-style: solid。"
  ],
  "checks": [
    {
      "id": "panel-bold",
      "type": "style",
      "selector": ".panel",
      "property": "font-weight",
      "equals": "700",
      "message": "parent .panel 应使用 700 字重"
    },
    {
      "id": "panel-border-solid",
      "type": "style",
      "selector": ".panel",
      "property": "border-top-style",
      "equals": "solid",
      "message": "parent .panel 应有 solid border style"
    },
    {
      "id": "child-inherits-bold",
      "type": "style",
      "selector": ".child",
      "property": "font-weight",
      "equals": "700",
      "message": ".child 应继承 700 字重"
    },
    {
      "id": "child-border-not-inherited",
      "type": "style",
      "selector": ".child",
      "property": "border-top-style",
      "equals": "none",
      "message": ".child 不应自动继承 parent 的 border style"
    }
  ],
