{
  "schemaVersion": 1,
  "id": "css.responsive-css.responsive-layout-strategies.add-selective-breakpoint.001",
  "revision": 1,
  "slug": "add-selective-breakpoint",
  "title": "添加 selective breakpoint",
  "prompt": "先确认窄屏 baseline：nav 会跟随 containing block，不应在 390px 横向溢出。每个 link 有约 132px 的最小 inline size，四个 link 横排时在 640px 附近才有足够空间。本题把 640px 作为给定的 reference condition，用它练习 mobile-first baseline → selective structural switch；不要把这个数字理解成通用设备 breakpoint。",
  "order": 3,
  "status": "published",
  "hints": [
    "先检查 baseline constraint：nav 本身是 fluid 的，390px 时 links 逐行显示，组件不需要靠 media query 才能避免横向溢出。",
    "四个 link 的最小 inline size 加上 gaps 会在大约 640px 的 viewport region 形成横排 content pressure；本题给定 640px 作为 reference condition，而不是要求你猜一个设备分类。",
    "保留窄空间的 block baseline，并在 @media (min-width: 640px) 中把 nav 切成 flex、gap:12px，同时让 links 变成 inline-block。"
  ],
  "checks": [
    {
      "id": "selective-nav-display-block-baseline",
      "type": "rule-style",
      "selector": ".nav",
      "property": "display",
      "equals": "block",
      "message": "为 nav 保留窄空间 baseline"
    },
    {
      "id": "selective-nav-link-display-block-baseline",
      "type": "rule-style",
      "selector": ".nav a",
      "property": "display",
      "equals": "block",
      "message": "让 nav link 在窄空间逐行显示"
    },
    {
      "id": "selective-nav-display-flex-wide",
      "type": "rule-style",
      "selector": ".nav",
      "property": "display",
      "equals": "flex",
      "media": "(min-width: 640px)",
      "message": "在宽空间切换 nav 为 flex"
    },
    {
      "id": "selective-nav-gap-wide",
      "type": "rule-style",
      "selector": ".nav",
      "property": "gap",
      "equals": "12px",
      "media": "(min-width: 640px)",
      "message": "为宽空间 nav links 设置间距"
    },
    {
      "id": "selective-nav-link-display-inline-block-wide",
      "type": "rule-style",
      "selector": ".nav a",
      "property": "display",
      "equals": "inline-block",
      "media": "(min-width: 640px)",
      "message": "在宽空间让 nav link 横向排列"
    },
    {
      "id": "selective-nav-display-mobile",
      "type": "viewport-style",
      "viewportWidth": 390,
      "selector": ".nav",
      "property": "display",
      "equals": "block",
      "message": "在 390px 视口使用 block nav"
    },
    {
      "id": "selective-nav-display-tablet",
      "type": "viewport-style",
      "viewportWidth": 768,
      "selector": ".nav",
      "property": "display",
      "equals": "flex",
      "message": "在 768px 视口使用 flex nav"
    },
    {
      "id": "selective-nav-display-desktop",
      "type": "viewport-style",
      "viewportWidth": 1280,
      "selector": ".nav",
      "property": "display",
      "equals": "flex",
      "message": "在 1280px 视口使用 flex nav"
    }
  ]
}
