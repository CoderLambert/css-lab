{
  "schemaVersion": 1,
  "id": "css.responsive-css.responsive-layout-strategies.integrate-responsive-component.001",
  "revision": 1,
  "slug": "integrate-responsive-component",
  "title": "综合 responsive component",
  "prompt": "base.css 已提供 surface 与 typography scaffolding。本题聚焦你需要真正决策的部分：外层 constraint、header/actions 的 Flex layout、body 的 Grid context，以及 selective responsive adaptation；最后结合固定 viewport 检查与 Preview review。",
  "order": 4,
  "status": "published",
  "hints": [
    "把 surface/typography 当作已提供 scaffolding；先确认 profile 在窄空间不超过 containing block。",
    "建立 header/actions 的 Flex context 与 body 的 Grid context，再观察哪些变化可以靠自然 layout 完成。",
    "最后只在给定宽空间条件中定义 body tracks/alignment；checker 证明 authored context/rules，完整 geometry 与 wrapping 仍在 Preview 比较。"
  ],
  "checks": [
    {
      "id": "profile-max-width",
      "type": "rule-style",
      "selector": ".profile",
      "property": "max-width",
      "equals": "100%",
      "message": "让 profile 不超过可用容器宽度"
    },
    {
      "id": "profile-header-display-flex",
      "type": "rule-style",
      "selector": ".profile-header",
      "property": "display",
      "equals": "flex",
      "message": "用 Flexbox 组织 profile header"
    },
    {
      "id": "profile-actions-display-flex",
      "type": "rule-style",
      "selector": ".profile-actions",
      "property": "display",
      "equals": "flex",
      "message": "让 profile actions 成为 flex container"
    },
    {
      "id": "profile-actions-flex-wrap",
      "type": "rule-style",
      "selector": ".profile-actions",
      "property": "flex-wrap",
      "equals": "wrap",
      "message": "允许 profile actions 在窄空间换行"
    },
    {
      "id": "profile-body-display-grid",
      "type": "rule-style",
      "selector": ".profile-body",
      "property": "display",
      "equals": "grid",
      "message": "先让 profile body 建立 Grid formatting context"
    },
    {
      "id": "profile-body-columns-wide",
      "type": "rule-style",
      "selector": ".profile-body",
      "property": "grid-template-columns",
      "equals": "minmax(0, 1fr) auto",
      "alsoAccepts": [
        "minmax(0px, 1fr) auto"
      ],
      "media": "(min-width: 640px)",
      "message": "在宽空间为 profile body 定义两列"
    },
    {
      "id": "profile-body-align-items-wide",
      "type": "rule-style",
      "selector": ".profile-body",
      "property": "align-items",
      "equals": "end",
      "media": "(min-width: 640px)",
      "message": "在宽空间让 profile body 沿末端对齐"
    },
    {
      "id": "profile-body-align-items-mobile",
      "type": "viewport-style",
      "viewportWidth": 390,
      "selector": ".profile-body",
      "property": "align-items",
      "equals": "normal",
      "message": "在 390px 视口保留窄空间 baseline"
    },
    {
      "id": "profile-body-align-items-tablet",
      "type": "viewport-style",
      "viewportWidth": 768,
      "selector": ".profile-body",
      "property": "align-items",
      "equals": "end",
      "message": "在 768px 视口启用宽空间对齐"
    },
    {
      "id": "profile-body-align-items-desktop",
      "type": "viewport-style",
      "viewportWidth": 1280,
      "selector": ".profile-body",
      "property": "align-items",
      "equals": "end",
      "message": "在 1280px 视口保持宽空间对齐"
    }
  ]
}
