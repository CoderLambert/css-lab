{
  "schemaVersion": 1,
  "id": "css.responsive-css.media-queries-and-breakpoints.mobile-first-override.001",
  "revision": 1,
  "slug": "mobile-first-override",
  "title": "建立 mobile-first override",
  "prompt": "本题不再让你重新选择 breakpoint：640px 是已经给定的练习条件。先写对所有窄空间成立的 block baseline，再在这个较宽条件中只覆盖需要变化的布局 declarations，并用 Preview 比较同一份 CSS。",
  "order": 2,
  "status": "published",
  "hints": [
    "先把 mobile-first 理解成 source structure：无条件 baseline 应在窄空间成立，query 只增加较宽空间真正需要的变化。",
    "本题的 640px 是提供给你的 threshold，不声称由这一题再次推导；重点是条件命中后 rules 仍要进入正常 cascade。",
    "在 `@media (min-width: 640px)` 中把 layout 改为 flex、gap 16px，并让 sidebar 使用 120px basis、content 参与 grow。"
  ],
  "checks": [
    {
      "id": "layout-display-block-baseline",
      "type": "rule-style",
      "selector": ".layout",
      "property": "display",
      "equals": "block",
      "message": "先为 layout 建立 block baseline"
    },
    {
      "id": "layout-display-flex-wide",
      "type": "rule-style",
      "selector": ".layout",
      "property": "display",
      "equals": "flex",
      "media": "(min-width: 640px)",
      "message": "在宽空间将 layout 切换为 flex"
    },
    {
      "id": "layout-gap-wide",
      "type": "rule-style",
      "selector": ".layout",
      "property": "gap",
      "equals": "16px",
      "media": "(min-width: 640px)",
      "message": "为宽空间 layout 设置列间距"
    },
    {
      "id": "sidebar-flex-basis-wide",
      "type": "rule-style",
      "selector": ".sidebar",
      "property": "flex-basis",
      "equals": "120px",
      "media": "(min-width: 640px)",
      "message": "为宽空间 sidebar 固定基础宽度"
    },
    {
      "id": "content-flex-grow-wide",
      "type": "rule-style",
      "selector": ".content",
      "property": "flex-grow",
      "equals": "1",
      "media": "(min-width: 640px)",
      "message": "让宽空间 content 吸收剩余空间"
    },
    {
      "id": "layout-display-mobile",
      "type": "viewport-style",
      "viewportWidth": 390,
      "selector": ".layout",
      "property": "display",
      "equals": "block",
      "message": "在 390px 视口保持 block layout"
    },
    {
      "id": "layout-display-tablet",
      "type": "viewport-style",
      "viewportWidth": 768,
      "selector": ".layout",
      "property": "display",
      "equals": "flex",
      "message": "在 768px 视口切换为 flex layout"
    },
    {
      "id": "layout-display-desktop",
      "type": "viewport-style",
      "viewportWidth": 1280,
      "selector": ".layout",
      "property": "display",
      "equals": "flex",
      "message": "在 1280px 视口保持 flex layout"
    }
  ]
}
