{
  "schemaVersion": 1,
  "id": "css.visual-styling-and-typography.interaction-states-and-focus.focus-visible-indicator.001",
  "revision": 1,
  "slug": "focus-visible-indicator",
  "title": "保留可见的键盘焦点",
  "prompt": "为 .action:focus-visible 设计清晰的 focus indicator；不要无条件删除 outline，也不要只依赖颜色变化。",
  "order": 2,
  "status": "published",
  "hints": [
    "focus indicator 的任务是告诉键盘使用者当前位置，不是把默认 outline 静默抹掉。",
    "`:focus-visible` 适合在浏览器判断需要可见提示时定制 ring；可以使用 outline-offset 增加间距。",
    "写一个 .action:focus-visible 规则，提供 3px solid outline 和 3px outline-offset。"
  ],
  "checks": [
    {
      "id": "action-focus-visible-outline-width",
      "type": "rule-style",
      "selector": ".action:focus-visible",
      "property": "outline-width",
      "equals": "3px",
      "message": "为 focus-visible 设置 3px outline"
    },
    {
      "id": "action-focus-visible-outline-style",
      "type": "rule-style",
      "selector": ".action:focus-visible",
      "property": "outline-style",
      "equals": "solid",
      "message": "为 focus-visible 使用 solid outline"
    },
    {
      "id": "action-focus-visible-outline-color",
      "type": "rule-style",
      "selector": ".action:focus-visible",
      "property": "outline-color",
      "equals": "rgb(26, 61, 47)",
      "message": "为 focus-visible 使用高对比 outline 颜色"
    },
    {
      "id": "action-focus-visible-outline-offset",
      "type": "rule-style",
      "selector": ".action:focus-visible",
      "property": "outline-offset",
      "equals": "3px",
      "message": "为 focus-visible 增加 3px outline 间距"
    }
  ]
}
