{
  "schemaVersion": 1,
  "id": "css.visual-styling-and-typography.interaction-states-and-focus.compare-focus-input.001",
  "revision": 1,
  "slug": "compare-focus-input",
  "title": "比较 focus 与 focus-visible",
  "prompt": "为两个按钮分别提供 :focus 与 :focus-visible 规则，观察指针与键盘输入可能触发的差异。",
  "order": 3,
  "status": "published",
  "hints": [
    "focus 说明元素拥有焦点；focus-visible 进一步考虑是否需要把焦点显著提示给用户。",
    "把两种 pseudo-class 分开写，避免把 pointer hover 当成 keyboard focus。",
    "分别写 .mouse-action:focus 与 .keyboard-action:focus-visible，再用鼠标和 Tab 操作比较。"
  ],
  "checks": [
    {
      "id": "mouse-action-focus-outline-width",
      "type": "rule-style",
      "selector": ".mouse-action:focus",
      "property": "outline-width",
      "equals": "3px",
      "message": "为鼠标按钮的 focus 状态设置 3px outline"
    },
    {
      "id": "mouse-action-focus-outline-style",
      "type": "rule-style",
      "selector": ".mouse-action:focus",
      "property": "outline-style",
      "equals": "solid",
      "message": "为鼠标按钮的 focus 状态使用 solid outline"
    },
    {
      "id": "keyboard-action-focus-visible-outline-width",
      "type": "rule-style",
      "selector": ".keyboard-action:focus-visible",
      "property": "outline-width",
      "equals": "3px",
      "message": "为键盘按钮的 focus-visible 设置 3px outline"
    },
    {
      "id": "keyboard-action-focus-visible-outline-style",
      "type": "rule-style",
      "selector": ".keyboard-action:focus-visible",
      "property": "outline-style",
      "equals": "dashed",
      "message": "为键盘按钮的 focus-visible 使用 dashed outline"
    },
    {
      "id": "keyboard-action-focus-visible-outline-offset",
      "type": "rule-style",
      "selector": ".keyboard-action:focus-visible",
      "property": "outline-offset",
      "equals": "3px",
      "message": "为键盘按钮的 focus-visible 增加 3px 间距"
    }
  ]
}
