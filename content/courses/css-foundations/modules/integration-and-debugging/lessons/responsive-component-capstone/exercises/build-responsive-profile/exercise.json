{
  "schemaVersion": 1,
  "id": "css.integration-and-debugging.responsive-component-capstone.build-responsive-profile.001",
  "revision": 1,
  "slug": "build-responsive-profile",
  "title": "构建 responsive profile",
  "prompt": "base.css 已提供 surface/typography scaffolding。请综合完成外层 max-width、header/actions Flex、body Grid、窄空间长 token wrapping，以及 640px 宽空间两列 adaptation；最后用 Preview 在 390/768/1280 回查 constraint、content pressure 与 layout context。",
  "order": 1,
  "status": "published",
  "hints": [
    "先区分 scaffolding 与 learner work：surface/typography 已给定；你要先让 dashboard 不超过 containing block，并处理 feature 中长 token 的 overflow pressure。",
    "建立 header/actions 的 Flex context 与 dashboard body 的 Grid context；窄空间先保持单列，并让长 token 能安全换行。",
    "最后在 640px 条件中为 Grid body 定义 `minmax(0, 2fr) minmax(160px, 1fr)`，并沿 diagnosis pipeline 检查 390/768/1280。"
  ],
  "checks": [
    {
      "id": "dashboard-max-width",
      "type": "rule-style",
      "selector": ".dashboard",
      "property": "max-width",
      "equals": "100%",
      "message": "让 dashboard 不超过可用容器宽度"
    },
    {
      "id": "dashboard-header-display-flex",
      "type": "rule-style",
      "selector": ".dashboard-header",
      "property": "display",
      "equals": "flex",
      "message": "用 Flexbox 组织 dashboard header"
    },
    {
      "id": "dashboard-actions-display-flex",
      "type": "rule-style",
      "selector": ".dashboard-actions",
      "property": "display",
      "equals": "flex",
      "message": "让 dashboard actions 成为 flex container"
    },
    {
      "id": "dashboard-actions-flex-wrap",
      "type": "rule-style",
      "selector": ".dashboard-actions",
      "property": "flex-wrap",
      "equals": "wrap",
      "message": "允许 dashboard actions 在窄空间换行"
    },
    {
      "id": "dashboard-grid-display-grid",
      "type": "rule-style",
      "selector": ".dashboard-grid",
      "property": "display",
      "equals": "grid",
      "message": "先让 dashboard body 建立 Grid formatting context"
    },
    {
      "id": "feature-overflow-wrap",
      "type": "rule-style",
      "selector": ".feature",
      "property": "overflow-wrap",
      "equals": "anywhere",
      "message": "让 feature 中的长 token 在窄空间可安全换行"
    },
    {
      "id": "dashboard-grid-columns-wide",
      "type": "rule-style",
      "selector": ".dashboard-grid",
      "property": "grid-template-columns",
      "equals": "minmax(0, 2fr) minmax(160px, 1fr)",
      "alsoAccepts": [
        "minmax(0px, 2fr) minmax(160px, 1fr)"
      ],
      "media": "(min-width: 640px)",
      "message": "在宽空间为 dashboard grid 定义两列"
    },
    {
      "id": "dashboard-grid-align-items-wide",
      "type": "rule-style",
      "selector": ".dashboard-grid",
      "property": "align-items",
      "equals": "start",
      "media": "(min-width: 640px)",
      "message": "在宽空间让 dashboard grid 项目沿起点对齐"
    },
    {
      "id": "dashboard-grid-align-items-mobile",
      "type": "viewport-style",
      "viewportWidth": 390,
      "selector": ".dashboard-grid",
      "property": "align-items",
      "equals": "normal",
      "message": "在 390px 视口保留窄空间 baseline"
    },
    {
      "id": "dashboard-grid-align-items-tablet",
      "type": "viewport-style",
      "viewportWidth": 768,
      "selector": ".dashboard-grid",
      "property": "align-items",
      "equals": "start",
      "message": "在 768px 视口启用宽空间对齐"
    },
    {
      "id": "dashboard-grid-align-items-desktop",
      "type": "viewport-style",
      "viewportWidth": 1280,
      "selector": ".dashboard-grid",
      "property": "align-items",
      "equals": "start",
      "message": "在 1280px 视口保持宽空间对齐"
    }
  ]
}
